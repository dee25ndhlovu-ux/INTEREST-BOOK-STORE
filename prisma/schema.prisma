// Schema for the closed-reader rebuild. See /docs/closed-reader-build-brief.md
// for the full architecture this maps to.
//
// This replaces the current data/products.json, data/categories.json, and the
// in-memory `orders` Map in server.js. Nothing here is wired into server.js
// yet — this is the schema and generated client only, added so the rest of
// the migration can build on top of it.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- accounts ----------
// Self-chosen username + password, not email. recovery_email is captured at
// signup but plays no role in day-to-day login (see brief §8, Authentication
// and recovery). Created at checkout time, not from an email afterwards.
model Account {
  id            String   @id @default(cuid())
  username      String   @unique
  passwordHash  String
  recoveryEmail String
  createdAt     DateTime @default(now())

  orders          Order[]
  entitlements    Entitlement[]
  readingProgress ReadingProgress[]

  @@map("accounts")
}

// ---------- catalogue ----------
// Seeded once from the existing data/categories.json.
model Category {
  id   String @id @default(cuid())
  name String @unique

  products Product[]

  @@map("categories")
}

enum RenderStatus {
  PENDING // pages not rendered yet — not purchasable
  PROCESSING // upload-time rendering in progress
  READY // every page rendered and cached — safe to sell
  FAILED
}

// Seeded once from the existing data/products.json. `sourcePdfKey` and
// `coverImageKey` are object keys in R2 (see lib/storage.js), not local
// filesystem paths — the master PDF is never served directly (brief §3).
model Product {
  id            String       @id @default(cuid())
  title         String
  description   String       @default("")
  price         Decimal      @db.Decimal(10, 2)
  categoryId    String?
  category      Category?    @relation(fields: [categoryId], references: [id])
  sourcePdfKey  String // R2 object key for the master PDF — private, never sent to a client
  coverImageKey String?
  pageCount     Int? // set once rendering finishes
  renderStatus  RenderStatus @default(PENDING)
  published     Boolean      @default(false) // forced false until renderStatus = READY
  createdAt     DateTime     @default(now())

  renderedPages   RenderedPage[]
  orders          Order[]
  entitlements    Entitlement[]
  readingProgress ReadingProgress[]

  @@map("products")
}

// One row per page per book — the clean, unwatermarked render cached at
// upload time (brief §3). Never sent to a client directly; the watermark is
// composited on top of this per view, per request.
model RenderedPage {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  pageNumber  Int
  imageKey    String // R2 object key for the clean rendered page image
  createdAt   DateTime @default(now())

  @@unique([productId, pageNumber])
  @@map("rendered_pages")
}

// ---------- orders & entitlements ----------
enum OrderStatus {
  PENDING
  PAID
  DELIVERED
  FAILED
  CANCELLED
}

// Replaces the in-memory `orders` Map in server.js. Field names mirror the
// existing order object there (ref, name, email, phone, amount, status) so
// the checkout/poll/webhook handlers can be ported over with minimal change.
model Order {
  id          String      @id @default(cuid())
  ref         String      @unique // e.g. "ORD-XXXXXXXX", same format as today
  accountId   String
  account     Account     @relation(fields: [accountId], references: [id])
  productId   String
  product     Product     @relation(fields: [productId], references: [id])
  name        String
  email       String
  phone       String
  amount      Decimal     @db.Decimal(10, 2)
  status      OrderStatus @default(PENDING)
  paynowPollUrl String?
  error       String?
  createdAt   DateTime    @default(now())
  paidAt      DateTime?
  deliveredAt DateTime?

  @@map("orders")
}

// What an account actually owns, written once an order reaches PAID.
// Kept separate from Order so the reader only ever needs one simple check
// ("does this account own this product") rather than reasoning through
// order/payment status each time (brief §8).
model Entitlement {
  id         String   @id @default(cuid())
  accountId  String
  account    Account  @relation(fields: [accountId], references: [id])
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  grantedAt  DateTime @default(now())

  @@unique([accountId, productId])
  @@map("entitlements")
}

// ---------- reading progress ----------
// Purchased-content progress only. Local-file-library progress (brief §7)
// stays on-device and does not sync through the server.
model ReadingProgress {
  accountId      String
  account        Account  @relation(fields: [accountId], references: [id])
  productId      String
  product        Product  @relation(fields: [productId], references: [id])
  lastPageViewed Int      @default(1)
  updatedAt      DateTime @updatedAt

  @@id([accountId, productId])
  @@map("reading_progress")
}
