// Schema for the direct-download store with creator revenue splits. See
// /docs/build-brief.md for the architecture this maps to. Supersedes the
// earlier closed-reader design — no buyer accounts, no page-by-page reader.

generator client {
  provider = "prisma-client-js"
}

// Prisma 7 removed `url` from this block — the connection string now lives
// in prisma.config.js (for the CLI/migrations) and is passed to PrismaClient
// via a driver adapter at runtime (see db.js). This block just declares the
// database kind.
datasource db {
  provider = "postgresql"
}

// ---------- catalogue ----------
// Seeded once from the existing data/categories.json. No longer used for
// storefront filtering (the redesigned store shows one flat grid), kept for
// admin-side organisation only.
model Category {
  id   String @id @default(cuid())
  name String @unique

  products Product[]

  @@map("categories")
}

// A book's creator, for revenue-split accounting. Added by admin with just
// name + username; the creator sets their own password the first time they
// sign in at /creator (see requireCreator in server.js).
model Creator {
  id           String   @id @default(cuid())
  name         String
  username     String   @unique
  passwordHash String? // null until first login — that login sets it
  createdAt    DateTime @default(now())

  products Product[]

  @@map("creators")
}

// `sourcePdfKey` is an R2 object key (see storage.js), not a local
// filesystem path — the master PDF is private and never sent to a client
// directly; a fresh watermarked copy is generated per order (see fulfil()
// in server.js). `creatorSplitPct` is the creator's share of each sale for
// this product (0-100); frozen into the order at sale time so a later
// change to this field never rewrites historical earnings.
model Product {
  id              String   @id @default(cuid())
  title           String
  description     String   @default("")
  price           Decimal  @db.Decimal(10, 2)
  categoryId      String?
  category        Category? @relation(fields: [categoryId], references: [id])
  sourcePdfKey    String // R2 object key for the master PDF — private, never sent to a client
  coverImageKey   String?
  published       Boolean  @default(false)
  creatorId       String?
  creator         Creator? @relation(fields: [creatorId], references: [id])
  creatorSplitPct Decimal  @default(0) @db.Decimal(5, 2) // 0-100
  createdAt       DateTime @default(now())

  orders Order[]

  @@map("products")
}

// ---------- orders ----------
enum OrderStatus {
  PENDING
  PAID
  DELIVERED
  FAILED
  CANCELLED
}

// No accountId — checkout no longer creates or requires a buyer account
// (just email + EcoCash number). `watermarkedPdfKey` and `downloadToken`
// back the direct-download link shown on the confirmation page and reused
// as a redownload link (see /api/orders/:ref/download in server.js) —
// generated once, at delivery time, so it survives independent of email
// success. creatorEarning/storeEarning are computed from the product's
// creatorSplitPct at delivery time and frozen here.
model Order {
  id                String      @id @default(cuid())
  ref               String      @unique // e.g. "ORD-XXXXXXXX"
  productId         String
  product           Product     @relation(fields: [productId], references: [id])
  email             String
  phone             String
  amount            Decimal     @db.Decimal(10, 2)
  status            OrderStatus @default(PENDING)
  paynowPollUrl     String?
  error             String?
  watermarkedPdfKey String?
  downloadToken     String?     @unique
  creatorEarning    Decimal?    @db.Decimal(10, 2)
  storeEarning      Decimal?    @db.Decimal(10, 2)
  createdAt         DateTime    @default(now())
  paidAt            DateTime?
  deliveredAt       DateTime?

  @@map("orders")
}
