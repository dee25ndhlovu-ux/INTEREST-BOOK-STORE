# Copy to .env for local development: cp .env.example .env

# ---------- server ----------
PORT=3000
BASE_URL=http://localhost:3000
DEMO_MODE=true
SESSION_SECRET=any-long-random-text
# Fallback admin password if data/settings.json gets wiped (see README).
ADMIN_PASSWORD=

# ---------- Paynow (EcoCash) ----------
# From paynow.co.zw -> Business -> Integrations. Not needed while
# DEMO_MODE=true. The checkout/poll/webhook code is already built (see
# closed-reader-build-brief.md §1) — going live needs only these two values.
PAYNOW_INTEGRATION_ID=
PAYNOW_INTEGRATION_KEY=

# ---------- email delivery (Brevo) ----------
# From Brevo -> SMTP & API -> "API Keys & MCP" tab. If unset, falls back to
# SMTP below, then to a free Ethereal test inbox (fine for local testing).
BREVO_API_KEY=
FROM_EMAIL="Interest Book Store <no-reply@example.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ---------- database (Postgres) ----------
# Render's own managed Postgres — use a paid instance, not the free tier
# (free Postgres on Render expires after 30 days + a 14-day grace period,
# then is deleted entirely — see closed-reader-build-brief.md §8).
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ---------- object storage (Cloudflare R2) ----------
# Master PDFs, cover images, and rendered page images live here, not on
# Render's disk, which is wiped on every restart/redeploy. R2 has a free
# tier to start on. Create an API token under R2 -> Manage API Tokens.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
